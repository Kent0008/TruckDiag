# TruckDiag API Configuration
PROJECT_NAME="TruckDiag API"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# SQLite (Default for local development)
DATABASE_URL="sqlite+aiosqlite:///./truckdiag.db"

# PostgreSQL (Example for production/Docker):
# DATABASE_URL="postgresql+asyncpg://truckdiag_user:secret@localhost:5432/truckdiag_db"

# CORS: In development "*" allows Android Emulator (10.0.2.2) and Wi-Fi devices.
# In production, restrict to trusted hosts.
CORS_ORIGINS=["*"]

# Diagnostic Simulator Settings
SIMULATOR_UPDATE_INTERVAL_SEC=1.0
LOG_LEVEL="INFO"
